# Port used by the Node/Express server
PORT=8080
# Server-side Anthropic API key used by the local Claude proxy
ANTHROPIC_API_KEY=replace-with-server-side-key
# Claude model name used by the proxy endpoints
CLAUDE_MODEL=claude-3-5-sonnet-20241022
# Google Maps JavaScript API key for browser map features
GOOGLE_MAPS_API_KEY=
